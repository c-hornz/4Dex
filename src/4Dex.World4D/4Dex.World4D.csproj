<Project Sdk="Microsoft.NET.Sdk">

  <!--
    World state: objects, cells, maze topology. Depends on Math4D only; no UnityEngine and no XR,
    so SPEC §3's "World4D must know nothing about Oculus" is enforced by what this assembly cannot link.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>4Dex.World4D</AssemblyName>
    <!-- Not FourDex.World4D: a namespace named like its World4D class would shadow that class from every other FourDex.* namespace. -->
    <RootNamespace>FourDex.World</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\4Dex.Math4D\4Dex.Math4D.csproj" />
  </ItemGroup>

</Project>
